# Public deployment addresses
EDGE_SERVER_NAME=api.example.com
CLIENT_ORIGIN=https://your-project.vercel.app
CERTBOT_EMAIL=you@example.com

# Generate these values on the VM. Use URL-safe hexadecimal for POSTGRES_PASSWORD.
POSTGRES_PASSWORD=replace-with-random-hex
JWT_SECRET=replace-with-at-least-32-random-characters
HMAC_SECRET=replace-with-another-32-random-characters
TELEMETRY_TOKEN=replace-with-a-random-service-token
ZAP_API_KEY=replace-with-a-random-zap-api-key

# The demo account is intentionally retained for the short-lived presentation deployment.
ADMIN_EMAIL=admin@sentinel.local
ADMIN_PASSWORD=demo1234

# AI runs only in the backend container. Never put this key in Vercel.
AI_PROVIDER=openai
OPENAI_API_KEY=replace-with-your-openai-api-key
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=1200
AI_DAILY_CALL_LIMIT=50
ADVERSARIAL_MAX_ROUNDS=5

# Runtime tuning
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
OPENSEARCH_TIMEOUT_MS=5000
SEARCH_OUTBOX_INTERVAL_MS=5000
ZAP_SCAN_TIMEOUT_MS=600000
CLEANUP_INTERVAL_MS=3600000
WAF_RELOAD_TIMEOUT_MS=15000
